# ─── LayerCall ───────────────────────────────────────────────
# Clave de https://www.layercall.com/ (opcional; sin ella = sandbox)
LAYERCALL_API_KEY=

# ─── Clerk (autenticación / registro) ────────────────────────
# Dashboard: https://dashboard.clerk.com → tu aplicación → API Keys
#
# PUBLICA (obligatoria en el frontend / build de Vite):
#   Debe empezar por pk_test_ o pk_live_
VITE_CLERK_PUBLISHABLE_KEY=

# SECRETA (solo servidor / Cloudflare Pages Functions, nunca en el cliente):
#   Debe empezar por sk_test_ o sk_live_
CLERK_SECRET_KEY=

# ─── Otros ───────────────────────────────────────────────────
APP_URL=https://ip-identificaitor.pages.dev
